{
  "info": {
    "name": "Employee Training Tracker - end-to-end (Team 28)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "EN: the whole story across S1, S2 and S3 through nginx: assign -> complete -> CertificateMissing -> upload -> verify -> Compliant, plus invalid cases. Run with: node scripts/run_newman.js\nFranco: el qessa kollaha 3abr S1 w S2 w S3 3an taree2 nginx, w kaman el 7alat el ghalat. Shaghalha b: node scripts/run_newman.js"
  },
  "item": [
    {
      "name": "0. Sign in",
      "item": [
        {
          "name": "Sign in: manager Mona (Operations)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('signed in (200)', () => pm.response.to.have.status(200));",
                  "const result = pm.response.json().AuthenticationResult || {};",
                  "pm.test('access token returned', () => pm.expect(result.AccessToken).to.be.a('string'));",
                  "pm.collectionVariables.set('managerToken', result.AccessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-amz-json-1.1"
              },
              {
                "key": "X-Amz-Target",
                "value": "AWSCognitoIdentityProviderService.InitiateAuth"
              }
            ],
            "url": "{{baseUrl}}/cognito/",
            "description": "EN: signs in through nginx /cognito/ like the browser. Franco: login 3an taree2 nginx /cognito/ zay el browser.",
            "body": {
              "mode": "raw",
              "raw": "{\"AuthFlow\":\"USER_PASSWORD_AUTH\",\"ClientId\":\"{{clientId}}\",\"AuthParameters\":{\"USERNAME\":\"mona.manager@example.com\",\"PASSWORD\":\"{{password}}\"}}"
            }
          }
        },
        {
          "name": "Sign in: employee Sara (Operations)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('signed in (200)', () => pm.response.to.have.status(200));",
                  "const result = pm.response.json().AuthenticationResult || {};",
                  "pm.test('access token returned', () => pm.expect(result.AccessToken).to.be.a('string'));",
                  "pm.collectionVariables.set('employeeToken', result.AccessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-amz-json-1.1"
              },
              {
                "key": "X-Amz-Target",
                "value": "AWSCognitoIdentityProviderService.InitiateAuth"
              }
            ],
            "url": "{{baseUrl}}/cognito/",
            "description": "EN: Sara is the employee of the scenario. Franco: Sara el mowazzafa bta3et el scenario.",
            "body": {
              "mode": "raw",
              "raw": "{\"AuthFlow\":\"USER_PASSWORD_AUTH\",\"ClientId\":\"{{clientId}}\",\"AuthParameters\":{\"USERNAME\":\"sara@example.com\",\"PASSWORD\":\"{{password}}\"}}"
            }
          }
        },
        {
          "name": "Sign in: manager Omar (Laboratory)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('signed in (200)', () => pm.response.to.have.status(200));",
                  "const result = pm.response.json().AuthenticationResult || {};",
                  "pm.test('access token returned', () => pm.expect(result.AccessToken).to.be.a('string'));",
                  "pm.collectionVariables.set('otherManagerToken', result.AccessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-amz-json-1.1"
              },
              {
                "key": "X-Amz-Target",
                "value": "AWSCognitoIdentityProviderService.InitiateAuth"
              }
            ],
            "url": "{{baseUrl}}/cognito/",
            "description": "EN: a manager of ANOTHER team, for the negative tests. Franco: manager team TANY lel tests el salba.",
            "body": {
              "mode": "raw",
              "raw": "{\"AuthFlow\":\"USER_PASSWORD_AUTH\",\"ClientId\":\"{{clientId}}\",\"AuthParameters\":{\"USERNAME\":\"omar.manager@example.com\",\"PASSWORD\":\"{{password}}\"}}"
            }
          }
        }
      ]
    },
    {
      "name": "Scenario",
      "item": [
        {
          "name": "1. Manager creates a training that needs a certificate",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('trainingName', 'Newman certified training ' + Date.now());",
                  "const d = (days) => new Date(Date.now() + days * 86400000).toISOString().slice(0, 10);",
                  "pm.collectionVariables.set('dueDate', d(30));",
                  "pm.collectionVariables.set('issueDate', d(0));",
                  "pm.collectionVariables.set('expiryDate', d(365));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const t = pm.response.json();",
                  "pm.test('requiresCertificate is true', () => pm.expect(t.requiresCertificate).to.eql(true));",
                  "pm.collectionVariables.set('trainingId', t.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/trainings",
            "description": "EN: S1. A new training each run (unique name), certificate required, valid 12 months. Franco: S1. Training gedeed kol run, me7tag certificate, saleh 12 shahr.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{trainingName}}\",\n  \"category\": \"NewmanE2E\",\n  \"requiresCertificate\": true,\n  \"validityMonths\": 12\n}"
            }
          }
        },
        {
          "name": "2. Manager assigns it to Sara",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const a = pm.response.json();",
                  "pm.test('status Assigned (calculated on read)', () => pm.expect(a.status).to.eql('Assigned'));",
                  "pm.collectionVariables.set('assignmentId', a.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/assignments",
            "description": "EN: S1. Manager of Sara's team assigns the training, due in 30 days. Franco: S1. Manager team Sara bey-assign el training, el due ba3d 30 yom.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeId\": \"{{saraId}}\",\n  \"trainingId\": \"{{trainingId}}\",\n  \"dueDate\": \"{{dueDate}}\"\n}"
            }
          }
        },
        {
          "name": "3. Sara sees the assignment in her list",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const mine = pm.response.json().find((a) => a.id === pm.collectionVariables.get('assignmentId'));",
                  "pm.test('the new assignment is there', () => pm.expect(mine).to.be.an('object'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{employeeToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/assignments/me",
            "description": "EN: S1. The employee's own list (id from her token). Franco: S1. List el mowazzafa nafsaha (el id men el token)."
          }
        },
        {
          "name": "4. Sara marks the training completed",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('status Completed', () => pm.expect(body.completed.status).to.eql('Completed'));",
                  "pm.test('renewal created', () => pm.expect(body.renewal).to.be.an('object'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{employeeToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/assignments/{{assignmentId}}/complete",
            "description": "EN: S1. Completing creates the next renewal (12 months). Franco: S1. El completion bey3mel el renewal el gai (12 shahr)."
          }
        },
        {
          "name": "5. Dashboard: Sara is Non-compliant, CertificateMissing",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const row = pm.response.json().find((r) => r.employeeId === pm.collectionVariables.get('saraId'));",
                  "pm.test('Sara is listed as Non-compliant', () => pm.expect(row).to.be.an('object'));",
                  "pm.test('reason CertificateMissing', () => pm.expect(row.reasons).to.include('CertificateMissing'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/dashboard/teams/10000000-0000-4000-8000-000000000001/employees?status=non-compliant",
            "description": "EN: S3 (reads S1 + S2). Completed + certificate required + no Verified certificate = CertificateMissing. Franco: S3. Khallaset + me7tag certificate + mafeesh Verified = CertificateMissing."
          }
        },
        {
          "name": "6. Sara uploads her certificate (PDF)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const c = pm.response.json();",
                  "pm.test('reviewStatus Pending', () => pm.expect(c.reviewStatus).to.eql('Pending'));",
                  "pm.collectionVariables.set('certificateId', c.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{employeeToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/certificates",
            "description": "EN: S2. Multipart upload; type checked by magic bytes; starts Pending. Franco: S2. Upload multipart; el type bel magic bytes; beyebda2 Pending.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "fixtures/certificate.pdf"
                },
                {
                  "key": "trainingId",
                  "value": "{{trainingId}}",
                  "type": "text"
                },
                {
                  "key": "title",
                  "value": "Newman E2E certificate",
                  "type": "text"
                },
                {
                  "key": "issuer",
                  "value": "Newman Test Institute",
                  "type": "text"
                },
                {
                  "key": "issueDate",
                  "value": "{{issueDate}}",
                  "type": "text"
                },
                {
                  "key": "expiryDate",
                  "value": "{{expiryDate}}",
                  "type": "text"
                }
              ]
            }
          }
        },
        {
          "name": "7. Dashboard: a Pending certificate does not count yet",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const row = pm.response.json().find((r) => r.employeeId === pm.collectionVariables.get('saraId'));",
                  "pm.test('Sara still CertificateMissing', () => pm.expect(row && row.reasons).to.include('CertificateMissing'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/dashboard/teams/10000000-0000-4000-8000-000000000001/employees?status=non-compliant",
            "description": "EN: S3. Only Verified certificates count, so Sara is still Non-compliant. Franco: S3. El Verified bas betet7seb, f Sara lessa Non-compliant."
          }
        },
        {
          "name": "8. Manager verifies the certificate",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('reviewStatus Verified', () => pm.expect(pm.response.json().reviewStatus).to.eql('Verified'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/certificates/{{certificateId}}/verify",
            "description": "EN: S2. Manager of the owner's team verifies. Franco: S2. Manager team el saheba bey-verify.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"verify\",\n  \"reason\": null\n}"
            }
          }
        },
        {
          "name": "9. Dashboard: Sara is Compliant",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const row = pm.response.json().find((r) => r.employeeId === pm.collectionVariables.get('saraId'));",
                  "pm.test('Sara is Compliant', () => pm.expect(row).to.be.an('object'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/dashboard/teams/10000000-0000-4000-8000-000000000001/employees?status=compliant",
            "description": "EN: S3. No Overdue and no open Missing/Expired flag = Compliant. Franco: S3. Mafeesh Overdue w mafeesh flag Missing/Expired = Compliant."
          }
        },
        {
          "name": "10. Dashboard summary and CSV report work",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('CSV content type', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/csv'));",
                  "pm.test('row for the new training', () => pm.expect(pm.response.text()).to.include(pm.collectionVariables.get('trainingName')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/reports/teams/10000000-0000-4000-8000-000000000001/export?category=NewmanE2E",
            "description": "EN: S3. The CSV export of this category has a row for the training. Franco: S3. El CSV bta3 el category feeh satr lel training."
          }
        }
      ]
    },
    {
      "name": "Invalid cases",
      "item": [
        {
          "name": "Invalid: bad token -> 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer not-a-real-token"
              }
            ],
            "url": "{{baseUrl}}/api/assignments/me",
            "description": "EN: a token that is not a JWT. Franco: token mesh JWT."
          }
        },
        {
          "name": "Invalid: employee opens the manager dashboard -> 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{employeeToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/dashboard/teams/10000000-0000-4000-8000-000000000001/summary",
            "description": "EN: wrong role. Franco: role ghalat."
          }
        },
        {
          "name": "Invalid: manager of another team -> 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{otherManagerToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/dashboard/teams/10000000-0000-4000-8000-000000000001/summary",
            "description": "EN: Omar manages Laboratory, not Operations. Franco: Omar modeer Laboratory mesh Operations."
          }
        },
        {
          "name": "Invalid: assignment due in the past -> 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/assignments",
            "description": "EN: dueDate must be today or later. Franco: el dueDate lazem el naharda aw ba3d kda.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeId\": \"{{saraId}}\",\n  \"trainingId\": \"{{trainingId}}\",\n  \"dueDate\": \"2020-01-01\"\n}"
            }
          }
        },
        {
          "name": "Invalid: employee tries to verify her own certificate -> 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{employeeToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/certificates/{{certificateId}}/verify",
            "description": "EN: only the team manager verifies. Franco: el manager bas beyverify.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"verify\",\n  \"reason\": null\n}"
            }
          }
        },
        {
          "name": "Invalid: trend with days=500 -> 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/dashboard/teams/10000000-0000-4000-8000-000000000001/trend?days=500",
            "description": "EN: days must be 1-90. Franco: days men 1 le 90."
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "saraId",
      "value": "20000000-0000-4000-8000-000000000003"
    }
  ]
}